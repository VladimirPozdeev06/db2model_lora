# Change values below to real values, these are placeholders
DB_USER = "username"
DB_PASS = "password"

# Teacher LLM. One key covers every model on the MIPT gateway; the teacher is
# chosen by LLM_MODEL_NAME alone. External GPT (gpt-4.1/4o) is NOT available for
# week-4 labelling (curator: paid API only for weeks 2-3), so the teacher must come
# from the locally-hosted pool.
#   LLM_MODEL_NAME = "Qwen/Qwen3.6-27B"   # chosen teacher: clean, ~2s/pair, 27B >> old 7B
# NB: Qwen3 reasons by default — generate_pairs.py sends enable_thinking=false, else
# the reply is all <think> and content comes back empty.
# Avoid deepseek-ai/DeepSeek-R1-Distill-Llama-70B here: this deployment returns
# byte-tokenizer garbage (spaces as U+0120, newlines as U+010A) and is slow.
LLM_BASE_URL = "https://my-base-url/api/v1"
LLM_API_KEY = "llm_api_key"
LLM_MODEL_NAME = "model_name"
